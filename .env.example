# 小云助手发布配置。首次执行 start.ps1 时自动复制为 .env。
# 路径相对当前项目根目录；移动整个目录后仍然有效。
# 使用完整云模型功能时填写自己的密钥，并确认账户有相应模型权限。
DASHSCOPE_API_KEY=
BAILIAN_HOST=https://dashscope.aliyuncs.com
CHAT_MODEL=qwen3.7-plus
VISION_MODEL=qwen3.7-plus
EMBEDDING_MODEL=text-embedding-v4
RERANK_MODEL=qwen3.7-text-rerank
MULTIMODAL_EMBEDDING_MODEL=tongyi-embedding-vision-flash-2026-03-06
EMBEDDING_DIMENSIONS=1024
ENABLE_RERANK=true
ENABLE_IMAGE_RETRIEVAL=false
MODEL_TIMEOUT_SECONDS=60
SQL_TIMEOUT_SECONDS=5
MAX_SQL_REPAIRS=1
DATABASE_PATH=data/public_benchmark/chinook/Chinook.sqlite
DOCUMENTS_PATH=data/public_benchmark/ohr/documents
INDEXES_PATH=data/public_benchmark/ohr/indexes
PARSED_PATH=data/public_benchmark/ohr/parsed
CONFIG_PATH=config/public_benchmark
DATASET_PROFILE=public
RAG_MIN_LEXICAL_COVERAGE=0.2
DEMO_DATA_LABEL="Chinook 公开样例：59位客户、412张发票（2009—2013）；OHR-Bench：1261份官方校对正文，非本地OCR结果"
VISUAL_LOCATION_ALLOWED_SHA256=
SUMMARY_MAX_BATCHES=96
SUMMARY_MERGE_CHARS=48000
SUMMARY_MAX_REDUCE_LEVELS=4
